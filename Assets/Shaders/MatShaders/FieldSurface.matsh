MaterialShader "Hestia/FieldSurface"
{
    RenderType = Forward;
    RenderPhase = Masked;
    Cull = None;

    Properties
    {
        _BaseMap ("Base Color", Texture2D) = "white"
        _ShadowTint ("Shadow Tint", Color) = (0.40, 0.54, 0.74, 1)
        _LightTint ("Light Tint", Color) = (1.0, 0.96, 0.84, 1)
        _RimStrength ("Rim Strength", Range(0, 1)) = 0.12
    }

    [InstancedStruct]
    struct InstanceData
    {
        float4x4 worldMatrix;
        float4 color;
    };

    SHARED_HLSL_BEGIN
    #include "../Common.hlsl"
    SHARED_HLSL_END

    Pass "FieldSurface"
    {
        HLSL_BEGIN
        #pragma vertex VSMain
        #pragma pixel PSMain

        struct VertexOutput
        {
            float4 position : SV_POSITION;
            float3 normal : TEXCOORD0;
            float2 uv : TEXCOORD1;
            float3 viewPosition : TEXCOORD2;
        };

        VertexOutput VSMain(float3 position : POSITION, float3 normal : NORMAL, float2 uv : TEXCOORD0,
            uint instanceID : SV_InstanceID)
        {
            const float4x4 model = Instances[instanceID].worldMatrix;
            const float4 worldPosition = mul(float4(position, 1.0f), model);
            const float4 viewPosition = mul(worldPosition, view);

            // 非均一スケールの法線を逆転置と同じ方向に変換する
            const float3 axisX = model[0].xyz;
            const float3 axisY = model[1].xyz;
            const float3 axisZ = model[2].xyz;
            const float3x3 cofactors = float3x3(cross(axisY, axisZ), cross(axisZ, axisX), cross(axisX, axisY));

            VertexOutput output;
            output.position = mul(viewPosition, proj);
            output.normal = mul(mul(normal, cofactors), (float3x3)view);
            output.uv = uv;
            output.viewPosition = viewPosition.xyz;
            return output;
        }

        float4 PSMain(VertexOutput input, bool isFrontFace : SV_IsFrontFace) : SV_Target0
        {
            const float4 albedo = _BaseMap.Sample(WrapLinearSampler, input.uv);
            clip(albedo.a - 0.5f);

            // 冷たい影、中間色、暖かい明部の三段に分け、境界だけを滑らかにする
            const float3 light = mul(normalize(float3(-0.4f, 0.7f, -0.6f)), (float3x3)view);
            const float3 normal = normalize(input.normal) * (isFrontFace ? 1.0f : -1.0f);
            const float nDotL = dot(normal, light);
            const float edgeWidth = clamp(0.5f * fwidth(nDotL), 0.025f, 0.10f);
            const float midBand = smoothstep(-edgeWidth, edgeWidth, nDotL);
            const float lightBand = smoothstep(0.55f - edgeWidth, 0.55f + edgeWidth, nDotL);
            const float3 midTint = lerp(_ShadowTint.rgb, _LightTint.rgb, 0.55f);
            const float3 tint = lerp(lerp(_ShadowTint.rgb, midTint, midBand), _LightTint.rgb, lightBand);

            // 光が当たる側の輪郭にだけ、元の色に馴染むリム光を足す
            const float3 viewDirection = normalize(-input.viewPosition);
            const float grazing = 1.0f - saturate(dot(normal, viewDirection));
            const float rim = smoothstep(0.65f, 0.93f, grazing) * midBand * _RimStrength;
            const float3 rimColor = lerp(albedo.rgb, _LightTint.rgb, 0.35f);
            const float3 lit = saturate(albedo.rgb * tint + rim * rimColor);

            // UNORM の描画先へ出力する色を sRGB にエンコードする
            const float3 srgb = lerp(12.92f * lit, 1.055f * pow(lit, 1.0f / 2.4f) - 0.055f,
                step(0.0031308f, lit));
            return float4(srgb, 1.0f);
        }
        HLSL_END
    }
}
