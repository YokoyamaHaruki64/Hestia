// 頂点色と Tint で Sprite の Texture を着色し、アルファ合成する。
MaterialShader "Hestia/Sprite"
{
    RenderType = Forward;

    Properties
    {
        _Tint ("Tint", Color) = (1, 1, 1, 1)
        _BaseMap ("Base Map", Texture2D) = "white"
    }

    Pass "Sprite"
    {
        RenderPhase = Transparent;
        Cull = None;
        Blend = Alpha;
        ZTest = Less;
        ZWrite = On;

        HLSL_BEGIN
        #pragma vertex VSMain
        #pragma pixel PSMain
        #include "../Common.hlsl"

        struct SpriteInput
        {
            float3 position : POSITION;
            float2 uv       : TEXCOORD0;
            float4 color    : COLOR;
        };

        PSInput_Sprite VSMain(SpriteInput input)
        {
            PSInput_Sprite output;
            output.position = mul(mul(mul(float4(input.position, 1.0f), world), view), proj);
            output.uv = input.uv;
            output.color = input.color;
            return output;
        }

        float4 PSMain(PSInput_Sprite input) : SV_Target0
        {
            return input.color * _BaseMap.Sample(WrapLinearSampler, input.uv) * _Tint;
        }
        HLSL_END
    }
}
